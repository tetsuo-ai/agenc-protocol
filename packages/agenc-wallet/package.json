{
  "name": "@tetsuo-ai/agenc-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "A wallet an agent can use but cannot drain: a small local service that holds the keys, gives every agent its own funded allowance, and turns plain requests (hire this, approve that, take a job) into AgenC marketplace transactions built with the MIT @tetsuo-ai/marketplace-sdk",
  "packageManager": "npm@11.18.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agenc-wallet": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/",
    "test:e2e": "vitest run tests-e2e/"
  },
  "dependencies": {
    "@tetsuo-ai/agenc-worker": "^0.3.0",
    "@tetsuo-ai/marketplace-sdk": "^0.13.0"
  },
  "peerDependencies": {
    "@solana/kit": "^6.9.0"
  },
  "devDependencies": {
    "@solana/kit": "6.9.0",
    "litesvm": "1.1.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetsuo-ai/agenc-protocol.git",
    "directory": "packages/agenc-wallet"
  },
  "homepage": "https://github.com/tetsuo-ai/agenc-protocol/tree/main/packages/agenc-wallet#readme",
  "bugs": {
    "url": "https://github.com/tetsuo-ai/agenc-protocol/issues"
  },
  "keywords": [
    "solana",
    "agenc",
    "marketplace",
    "wallet",
    "agents",
    "allowance",
    "escrow"
  ],
  "author": "Tetsuo AI",
  "engines": {
    "node": ">=22.23.1"
  }
}
